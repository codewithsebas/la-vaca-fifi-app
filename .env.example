# Copia este archivo a .env.local y completa los valores. Este archivo se sube a git: nunca pongas aquí claves reales.
# Las variables con prefijo NEXT_PUBLIC_ llegan al navegador: solo URL y claves publicables. Todo lo secreto va sin ese prefijo.

# Supabase: Dashboard → Connect (URL y clave publicable)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Solo servidor. Dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_…

# URL pública del sitio (enlaces de los correos y retorno de la pasarela). Sin ella se usa la del request.
# NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.co

# Pagos con Wompi (comercios.wompi.co → Desarrolladores). Llaves de prueba: pub_test_ / prv_test_ / test_events_ / test_integrity_.
# URL de eventos para configurar en Wompi: https://<tu-dominio>/api/payments/webhook
WOMPI_PUBLIC_KEY=pub_test_…
WOMPI_PRIVATE_KEY=prv_test_…
WOMPI_EVENTS_SECRET=test_events_…
WOMPI_INTEGRITY_SECRET=test_integrity_…
# Sin llaves de Wompi, en desarrollo se usa la pasarela simulada (/pago-simulado). Para forzar una: wompi | simulado
# PAYMENTS_PROVIDER=simulado
# El simulador está apagado en producción. Solo para un entorno de pruebas publicado (nunca con huéspedes reales):
# ALLOW_PAYMENT_SIMULATOR=1

# Correos con Resend (resend.com → API Keys). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=re_…
# Remitente de un dominio verificado en Resend. Sin dominio verificado, onboarding@resend.dev solo envía al correo de tu cuenta.
# EMAIL_FROM=La Vaca Fifí <reservas@tu-dominio.co>
# EMAIL_REPLY_TO=reservas@tu-dominio.co

# Notificaciones push del panel (llaves VAPID). Generarlas una sola vez con: npx web-push generate-vapid-keys
# Usa las MISMAS en local y en el servidor (Hostinger): un dispositivo registrado con otra llave pública no recibe nada.
# La URL a la que la base de datos avisa de cada aviso nuevo vive en Supabase Vault ('push_dispatch_url' → https://<tu-dominio>/api/push/dispatch).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B…
VAPID_PRIVATE_KEY=…
# Contacto para los servicios push (https://… o mailto:…). Sin él se usa NEXT_PUBLIC_SITE_URL.
VAPID_SUBJECT=https://www.tu-dominio.co

# Sincronización con Booking.com: la base de datos llama cada 5 minutos a /api/channels/sync con este secreto.
# Debe ser el mismo valor que el secreto 'channel_sync_secret' de Supabase Vault (y 'channel_sync_url' = https://<dominio>/api/channels/sync).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_SYNC_SECRET=

# Opcional: Cloudflare Turnstile (antispam). Sin estas claves se usa la casilla simulada.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Solo el panel: las páginas del sitio público redirigen a /admin y su API responde 404 (proxy.ts). Quitarla publica todo.
# SOLO_PANEL=1

# Opcional: demo sin backend (datos en el navegador).
# NEXT_PUBLIC_USE_MOCK_API=1
